{
  "name": "ashcoft/nextcloud-cad-viewer",
  "description": "A Nextcloud app to view CAD files in the browser",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "ashcoft",
      "email": "dony@dony.me",
      "homepage": "https://github.com/ashcoft/nextcloud-cad-viewer"
    }
  ],
  "require": {
    "bamarni/composer-bin-plugin": "^1.8",
    "php": "^8.5"
  },
  "require-dev": {
    "nextcloud/ocp": "dev-stable33",
    "phpunit/phpunit": "^10.4",
    "roave/security-advisories": "dev-latest",
    "vimeo/psalm": "^5.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/nextcloud-releases/ocp.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "OCA\\CadViewer\\": "lib/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@composer bin all install --ansi"
    ],
    "post-update-cmd": [
      "@composer bin all install --ansi"
    ],
    "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm --threads=1 --no-cache",
    "test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
    "openapi": "php -r 'echo \"No OpenAPI generation required - this app uses the external CAD viewer library\\n\";' && exit 0"
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    }
  }
}
