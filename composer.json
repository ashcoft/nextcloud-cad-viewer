{
  "name": "ashcoft/nextcloud-cad-viewer",
  "description": "A Nextcloud app to view CAD files in the browser",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "ashcoft",
      "email": "dony@dony.me",
      "homepage": "https://github.com/ashcoft/nextcloud-cad-viewer"
    }
  ],
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "nextcloud/coding-standard": "^1.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.4",
    "roave/security-advisories": "dev-latest",
    "symfony/event-dispatcher": "^7.0",
    "symfony/finder": "^7.0",
    "symfony/options-resolver": "^7.0",
    "symfony/process": "^7.0",
    "symfony/stopwatch": "^7.0",
    "symfony/string": "^7.0",
    "vimeo/psalm": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "OCA\\CadViewer\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\CadViewer\\Tests\\Unit\\": "tests/unit/",
      "OCP\\": "vendor/nextcloud/ocp/OCP/",
      "NCU\\": "vendor/nextcloud/ocp/NCU/",
      "OC\\": "tests/stubs/OC/"
    }
  },
  "scripts": {
    "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm --threads=1 --no-cache",
    "phpstan": "phpstan analyze --no-progress",
    "rector": "rector process",
    "test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
    "openapi": "php -r 'echo \"No OpenAPI generation required - this app uses the external CAD viewer library\\n\";' && exit 0"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  }
}
