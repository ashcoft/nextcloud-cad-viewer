{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "globals": {
    "OCA": "readonly",
    "OC": "readonly",
    "t": "readonly",
    "n": "readonly",
    "document": "readonly",
    "window": "readonly",
    "URLSearchParams": "readonly"
  },
  "extends": [
    "eslint:recommended"
  ],
  "rules": {
    "no-console": "off",
    "no-undef": "warn"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "**/*.test.ts", "**/*.spec.ts"],
      "env": {
        "jest": true,
        "node": true
      },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "jest": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "require": "readonly"
      }
    }
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  }
}
