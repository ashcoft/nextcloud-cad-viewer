{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "extra-files": [
    {
      "type": "xml",
      "path": "appinfo/info.xml",
      "xpath": "/info/version"
    }
  ],
  "packages": {
    ".": {
      "component": "nextcloud-cad-viewer",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": {
        "feat": "Features",
        "fix": "Bug Fixes",
        "perf": "Performance",
        "refactor": "Refactoring",
        "docs": "Documentation",
        "test": "Testing",
        "ci": "CI/CD",
        "chore": "Maintenance",
        "deps": "Dependencies",
        "build": "Build System"
      }
    }
  }
}
