#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/nextcloud-cad-viewer/nextcloud-cad-viewer/node_modules/.pnpm/webpack@5.107.2_postcss@8.5.15_webpack-cli@7.0.3/node_modules/webpack/node_modules:/home/runner/work/nextcloud-cad-viewer/nextcloud-cad-viewer/node_modules/.pnpm/webpack@5.107.2_postcss@8.5.15_webpack-cli@7.0.3/node_modules:/home/runner/work/nextcloud-cad-viewer/nextcloud-cad-viewer/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/nextcloud-cad-viewer/nextcloud-cad-viewer/node_modules/.pnpm/webpack@5.107.2_postcss@8.5.15_webpack-cli@7.0.3/node_modules/webpack/node_modules:/home/runner/work/nextcloud-cad-viewer/nextcloud-cad-viewer/node_modules/.pnpm/webpack@5.107.2_postcss@8.5.15_webpack-cli@7.0.3/node_modules:/home/runner/work/nextcloud-cad-viewer/nextcloud-cad-viewer/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../webpack/bin/webpack.js" "$@"
else
  exec node  "$basedir/../webpack/bin/webpack.js" "$@"
fi
