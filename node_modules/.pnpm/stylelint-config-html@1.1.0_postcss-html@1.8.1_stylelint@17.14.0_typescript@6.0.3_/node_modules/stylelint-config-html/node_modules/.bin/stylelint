#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/project/nextcloud-cad-viewer/node_modules/.pnpm/stylelint@17.14.0_typescript@6.0.3/node_modules/stylelint/node_modules:/workspace/project/nextcloud-cad-viewer/node_modules/.pnpm/stylelint@17.14.0_typescript@6.0.3/node_modules:/workspace/project/nextcloud-cad-viewer/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/project/nextcloud-cad-viewer/node_modules/.pnpm/stylelint@17.14.0_typescript@6.0.3/node_modules/stylelint/node_modules:/workspace/project/nextcloud-cad-viewer/node_modules/.pnpm/stylelint@17.14.0_typescript@6.0.3/node_modules:/workspace/project/nextcloud-cad-viewer/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../stylelint/bin/stylelint.mjs" "$@"
else
  exec node  "$basedir/../../../stylelint/bin/stylelint.mjs" "$@"
fi
