{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies",
    "renovate",
    "createChangeset"
  ],
  "description": "Renovate configuration for nextcloud-cad-viewer",
  "packageRules": [
    {
      "description": "Group mlightcad ecosystem updates",
      "groupName": "mlightcad-ecosystem",
      "matchPackageNames": [
        "/@mlightcad/*/"
      ]
    },
    {
      "description": "Group Vue-related dependencies",
      "groupName": "vue-dependencies",
      "matchPackageNames": [
        "/@vue/*/",
        "/vue*/"
      ]
    },
    {
      "description": "Group Babel-related dependencies",
      "groupName": "babel-dependencies",
      "matchPackageNames": [
        "/@babel/*/",
        "/babel-*/"
      ]
    },
    {
      "description": "Skip phpunit update - v13.2.1 requires sebastian/diff ^9.0 but vimeo/psalm only supports ^8.0",
      "matchPackageNames": ["phpunit/phpunit"],
      "enabled": false
    },
    {
      "description": "Disable updates for locked versions in overrides",
      "matchPackageNames": [
        "@mlightcad/data-model",
        "@mlightcad/libredwg-converter",
        "@mlightcad/mtext-input-box",
        "@mlightcad/mtext-renderer",
        "@mlightcad/ribbon",
        "element-plus",
        "three",
        "vue",
        "vue-i18n"
      ],
      "enabled": false
    }
  ],
  "composer": {
    "enabled": true
  },
  "npm": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5
}
