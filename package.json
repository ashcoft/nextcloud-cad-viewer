    "@vue/vue3-jest": "^29.2.6",
    "ajv": "^8.20.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.2",
